{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:memstack:cron-reverse-drain-observation:v1",
  "title": "Scheduler reverse drain observation",
  "description": "Durable record of what drained after Rust admission closed: open-state counts, terminal outcomes since reverse preparation, and the last drained run ids. Diagnostics for operator verification; never an activation switch. Queued, interrupted, waiting and retryable work is durable resumable remainder; only live mid-flight execution blocks rollback completion.",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol", "counts", "terminal_outcomes", "last_run_ids", "observed_at"],
  "properties": {
    "protocol": {"const": "cron-reverse-drain-observation.v1"},
    "counts": {
      "type": "object",
      "maxProperties": 64,
      "propertyNames": {"type": "string", "minLength": 1, "maxLength": 255},
      "additionalProperties": {"type": "integer", "minimum": 0}
    },
    "terminal_outcomes": {
      "type": "object",
      "propertyNames": {"enum": ["success", "failed", "timeout", "cancelled", "skipped"]},
      "additionalProperties": {"type": "integer", "minimum": 0}
    },
    "last_run_ids": {
      "type": "array",
      "maxItems": 100,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 255}
    },
    "observed_at": {"type": "string", "minLength": 1, "maxLength": 255}
  }
}
