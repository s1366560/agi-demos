{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://memstack.local/schemas/native-knowledge-definitions-10.v1.schema.json",
  "title": "Native knowledge definitions 10",
  "$defs": {
    "NativeKnowledgeCloudGenerationDescriptor": {
      "type": "object",
      "properties": {
        "profile_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "generation": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "profile_id",
        "generation",
        "digest"
      ],
      "additionalProperties": false,
      "x-rust-name": "SyncCloudGenerationDescriptor"
    },
    "NativeKnowledgeCloudGeneration": {
      "type": "object",
      "properties": {
        "contract_version": {
          "type": "string",
          "const": "1.0.0"
        },
        "descriptor": {
          "$ref": "native-knowledge.v1.schema.json#/$defs/NativeKnowledgeCloudGenerationDescriptor"
        }
      },
      "required": [
        "contract_version",
        "descriptor"
      ],
      "additionalProperties": false,
      "x-rust-name": "SyncCloudGeneration"
    },
    "NativeKnowledgeSyncConnection": {
      "type": "object",
      "properties": {
        "connection_revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "authority": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "actor_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      },
      "required": [
        "connection_revision",
        "authority",
        "actor_id"
      ],
      "additionalProperties": false,
      "x-rust-name": "SyncCloudConnectionProjection"
    },
    "NativeKnowledgeSyncTenant": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "name": {
          "type": "string",
          "maxLength": 4096
        }
      },
      "required": [
        "id",
        "name"
      ],
      "additionalProperties": false,
      "x-rust-name": "SyncCloudTenant"
    },
    "NativeKnowledgeSyncProject": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "tenant_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "name": {
          "type": "string",
          "maxLength": 4096
        }
      },
      "required": [
        "id",
        "tenant_id",
        "name"
      ],
      "additionalProperties": false,
      "x-rust-name": "SyncCloudProject"
    },
    "NativeKnowledgeSyncEnrollment": {
      "type": "object",
      "properties": {
        "contract_version": {
          "type": "string",
          "const": "1.0.0"
        },
        "tenant_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "project_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "actor_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "enabled": {
          "type": "boolean"
        },
        "can_enroll": {
          "type": "boolean"
        },
        "bootstrap_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "next_cursor": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "replayed": {
          "type": "boolean"
        },
        "generation": {
          "$ref": "native-knowledge.v1.schema.json#/$defs/NativeKnowledgeCloudGeneration"
        }
      },
      "required": [
        "contract_version",
        "tenant_id",
        "project_id",
        "actor_id",
        "enabled",
        "can_enroll",
        "bootstrap_count",
        "next_cursor",
        "replayed",
        "generation"
      ],
      "additionalProperties": false,
      "x-rust-name": "SyncCloudEnrollment"
    }
  }
}
