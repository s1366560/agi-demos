{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://memstack.local/schemas/native-knowledge-definitions-12.v1.schema.json",
  "title": "Native knowledge diagnostic metadata",
  "$defs": {
    "NativeKnowledgeDiagnosticRequest": {
      "type": "object",
      "properties": {
        "cursor": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "x-rust-type": "usize"
        }
      },
      "required": [
        "limit"
      ],
      "additionalProperties": false,
      "x-rust-type": "agistack_core::knowledge::diagnostics::DiagnosticRequest"
    },
    "NativeKnowledgeProcessingFailureDetail": {
      "type": "object",
      "properties": {
        "source": {
          "$ref": "native-knowledge.v1.schema.json#/$defs/NativeKnowledgeProcessingSource"
        },
        "attempt": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "failure": {
          "enum": [
            "model_unconfigured",
            "provider_unavailable",
            "invalid_extraction",
            "cancelled",
            "processing_failed"
          ]
        }
      },
      "required": [
        "source",
        "attempt",
        "failure"
      ],
      "additionalProperties": false
    },
    "NativeKnowledgeIndexFailureDetail": {
      "type": "object",
      "properties": {
        "input": {
          "$ref": "native-knowledge.v1.schema.json#/$defs/NativeKnowledgeIndexSource"
        },
        "attempt": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "failure": {
          "enum": [
            "provider_unavailable",
            "profile_changed",
            "invalid_embedding",
            "cancelled"
          ]
        }
      },
      "required": [
        "input",
        "attempt",
        "failure"
      ],
      "additionalProperties": false
    },
    "NativeKnowledgeAuditSummary": {
      "type": "object",
      "properties": {
        "source": {
          "$ref": "native-knowledge.v1.schema.json#/$defs/NativeKnowledgeProcessingSource"
        },
        "attempt": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "agent_id": {
          "type": "string"
        },
        "provider_id": {
          "type": "string"
        },
        "model_id": {
          "type": "string"
        },
        "tool_name": {
          "type": "string"
        },
        "contract_version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "started_at_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "finished_at_ms": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "latency_ms": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "enum": [
            "running",
            "applied",
            "failed"
          ]
        },
        "failure": {
          "anyOf": [
            {
              "enum": [
                "provider_unavailable",
                "invalid_extraction",
                "cancelled",
                "lease_lost",
                "admission_changed",
                "internal_failure"
              ]
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "source",
        "attempt",
        "agent_id",
        "provider_id",
        "model_id",
        "tool_name",
        "contract_version",
        "started_at_ms",
        "finished_at_ms",
        "latency_ms",
        "status",
        "failure"
      ],
      "additionalProperties": false
    },
    "NativeKnowledgeProcessingTaskSnapshot": {
      "type": "object",
      "properties": {
        "source": {
          "$ref": "native-knowledge.v1.schema.json#/$defs/NativeKnowledgeProcessingSource"
        },
        "current": {
          "type": "boolean"
        },
        "task": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "state": {
                  "type": "string",
                  "enum": [
                    "pending",
                    "leased",
                    "completed",
                    "failed",
                    "superseded"
                  ]
                },
                "attempt": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 4294967295
                },
                "failure": {
                  "anyOf": [
                    {
                      "$ref": "native-knowledge.v1.schema.json#/$defs/NativeKnowledgeProcessingFailure"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "state",
                "attempt",
                "failure"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "source",
        "current",
        "task"
      ],
      "additionalProperties": false
    }
  }
}
