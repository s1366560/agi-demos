{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://memstack.local/schemas/native-knowledge-definitions-12.v1.schema.json",
  "title": "Native knowledge diagnostic metadata",
  "$defs": {
    "NativeKnowledgeDiagnosticRequest": {
      "type": "object",
      "properties": {
        "cursor": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "x-rust-type": "usize"
        }
      },
      "required": [
        "limit"
      ],
      "additionalProperties": false,
      "x-rust-type": "agistack_core::knowledge::diagnostics::DiagnosticRequest"
    },
    "NativeKnowledgeProcessingFailureDetail": {
      "type": "object",
      "properties": {
        "source": {
          "$ref": "native-knowledge.v1.schema.json#/$defs/NativeKnowledgeProcessingSource"
        },
        "attempt": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "failure": {
          "enum": [
            "model_unconfigured",
            "provider_unavailable",
            "invalid_extraction",
            "cancelled",
            "processing_failed"
          ]
        }
      },
      "required": [
        "source",
        "attempt",
        "failure"
      ],
      "additionalProperties": false
    },
    "NativeKnowledgeIndexFailureDetail": {
      "type": "object",
      "properties": {
        "input": {
          "$ref": "native-knowledge.v1.schema.json#/$defs/NativeKnowledgeIndexSource"
        },
        "attempt": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "failure": {
          "enum": [
            "provider_unavailable",
            "profile_changed",
            "invalid_embedding",
            "cancelled"
          ]
        }
      },
      "required": [
        "input",
        "attempt",
        "failure"
      ],
      "additionalProperties": false
    },
    "NativeKnowledgeAuditSummary": {
      "type": "object",
      "properties": {
        "source": {
          "$ref": "native-knowledge.v1.schema.json#/$defs/NativeKnowledgeProcessingSource"
        },
        "attempt": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "agent_id": {
          "type": "string"
        },
        "provider_id": {
          "type": "string"
        },
        "model_id": {
          "type": "string"
        },
        "tool_name": {
          "type": "string"
        },
        "contract_version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "started_at_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "finished_at_ms": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "latency_ms": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "enum": [
            "running",
            "applied",
            "failed"
          ]
        },
        "failure": {
          "anyOf": [
            {
              "enum": [
                "provider_unavailable",
                "invalid_extraction",
                "cancelled",
                "lease_lost",
                "admission_changed",
                "internal_failure"
              ]
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "source",
        "attempt",
        "agent_id",
        "provider_id",
        "model_id",
        "tool_name",
        "contract_version",
        "started_at_ms",
        "finished_at_ms",
        "latency_ms",
        "status",
        "failure"
      ],
      "additionalProperties": false
    },
    "NativeKnowledgeProcessingTaskSnapshot": {
      "type": "object",
      "properties": {
        "source": {
          "$ref": "native-knowledge.v1.schema.json#/$defs/NativeKnowledgeProcessingSource"
        },
        "current": {
          "type": "boolean"
        },
        "task": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "state": {
                  "type": "string",
                  "enum": [
                    "pending",
                    "leased",
                    "completed",
                    "failed",
                    "superseded"
                  ]
                },
                "attempt": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 4294967295
                },
                "failure": {
                  "anyOf": [
                    {
                      "$ref": "native-knowledge.v1.schema.json#/$defs/NativeKnowledgeProcessingFailure"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "state",
                "attempt",
                "failure"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "source",
        "current",
        "task"
      ],
      "additionalProperties": false
    },
    "NativeKnowledgeDiagnosticsExportApplication": {
      "type": "object",
      "properties": {
        "module_ref": {
          "type": "string"
        },
        "service": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "knowledge_schema_version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "module_ref",
        "service",
        "version",
        "knowledge_schema_version"
      ],
      "additionalProperties": false
    },
    "NativeKnowledgeDiagnosticsExportScope": {
      "type": "object",
      "properties": {
        "tenant_id": {
          "type": "string"
        },
        "project_id": {
          "type": "string"
        },
        "context_revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "profile_id": {
          "type": "string"
        },
        "generation": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "digest": {
          "type": "string"
        }
      },
      "required": [
        "tenant_id",
        "project_id",
        "context_revision",
        "profile_id",
        "generation",
        "digest"
      ],
      "additionalProperties": false
    },
    "NativeKnowledgeDiagnosticsExportProcessing": {
      "type": "object",
      "properties": {
        "coverage": {
          "$ref": "native-knowledge.v1.schema.json#/$defs/NativeKnowledgeProcessingCoverage"
        },
        "last_success_ms": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "failed": {
          "type": "array",
          "items": {
            "$ref": "native-knowledge.v1.schema.json#/$defs/NativeKnowledgeProcessingFailureDetail"
          },
          "maxItems": 100
        },
        "truncated": {
          "type": "boolean"
        }
      },
      "required": [
        "coverage",
        "last_success_ms",
        "failed",
        "truncated"
      ],
      "additionalProperties": false
    },
    "NativeKnowledgeDiagnosticsExportIndex": {
      "type": "object",
      "properties": {
        "configuration": {
          "anyOf": [
            {
              "$ref": "native-knowledge.v1.schema.json#/$defs/NativeKnowledgeEmbeddingConfiguration"
            },
            {
              "type": "null"
            }
          ]
        },
        "active_build_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "coverage": {
          "anyOf": [
            {
              "$ref": "native-knowledge.v1.schema.json#/$defs/NativeKnowledgeIndexCoverage"
            },
            {
              "type": "null"
            }
          ]
        },
        "last_success_ms": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "failed": {
          "type": "array",
          "items": {
            "$ref": "native-knowledge.v1.schema.json#/$defs/NativeKnowledgeIndexFailureDetail"
          },
          "maxItems": 100
        },
        "truncated": {
          "type": "boolean"
        }
      },
      "required": [
        "configuration",
        "active_build_id",
        "coverage",
        "last_success_ms",
        "failed",
        "truncated"
      ],
      "additionalProperties": false
    },
    "NativeKnowledgeDiagnosticsExportSync": {
      "type": "object",
      "properties": {
        "linked": {
          "type": "boolean"
        },
        "pending_changes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "pending_graph_changes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "pull_conflicts": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "push_conflicts": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "graph_pull_conflicts": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "graph_push_conflicts": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "pull_cursor": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "graph_pull_cursor": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "last_receipt_sequence": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "linked",
        "pending_changes",
        "pending_graph_changes",
        "pull_conflicts",
        "push_conflicts",
        "graph_pull_conflicts",
        "graph_push_conflicts",
        "pull_cursor",
        "graph_pull_cursor",
        "last_receipt_sequence"
      ],
      "additionalProperties": false
    },
    "NativeKnowledgeDiagnosticsExport": {
      "type": "object",
      "properties": {
        "diagnostics_export_version": {
          "const": 1
        },
        "generated_at_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "application": {
          "$ref": "native-knowledge.v1.schema.json#/$defs/NativeKnowledgeDiagnosticsExportApplication"
        },
        "scope": {
          "$ref": "native-knowledge.v1.schema.json#/$defs/NativeKnowledgeDiagnosticsExportScope"
        },
        "processing": {
          "$ref": "native-knowledge.v1.schema.json#/$defs/NativeKnowledgeDiagnosticsExportProcessing"
        },
        "index": {
          "$ref": "native-knowledge.v1.schema.json#/$defs/NativeKnowledgeDiagnosticsExportIndex"
        },
        "sync": {
          "anyOf": [
            {
              "$ref": "native-knowledge.v1.schema.json#/$defs/NativeKnowledgeDiagnosticsExportSync"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "diagnostics_export_version",
        "generated_at_ms",
        "application",
        "scope",
        "processing",
        "index",
        "sync"
      ],
      "additionalProperties": false
    }
  }
}
