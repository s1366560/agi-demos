{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://memstack.local/schemas/native-knowledge-definitions-14.v1.schema.json",
  "title": "Native knowledge community definitions 14",
  "$defs": {
    "NativeKnowledgeCommunityResult": {
      "type": "object",
      "properties": {
        "build_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "candidate_id": {
          "type": "string",
          "minLength": 64,
          "maxLength": 64,
          "pattern": "^[0-9a-f]{64}$"
        },
        "attempt": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295,
          "x-rust-type": "u32"
        },
        "submission": {
          "$ref": "native-knowledge.v1.schema.json#/$defs/NativeKnowledgeCommunitySubmission"
        },
        "finished_at_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "build_id",
        "candidate_id",
        "attempt",
        "submission",
        "finished_at_ms"
      ],
      "additionalProperties": false
    },
    "NativeKnowledgeCommunityJobStatus": {
      "type": "object",
      "properties": {
        "build_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "candidate_id": {
          "type": "string",
          "minLength": 64,
          "maxLength": 64,
          "pattern": "^[0-9a-f]{64}$"
        },
        "state": {
          "enum": [
            "pending",
            "leased",
            "failed",
            "completed"
          ]
        },
        "attempt": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "failure": {
          "anyOf": [
            {
              "enum": [
                "cancelled",
                "worker_unavailable",
                "execution_failed"
              ]
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "build_id",
        "candidate_id",
        "state",
        "attempt",
        "failure"
      ],
      "additionalProperties": false
    },
    "NativeKnowledgeCommunityAuditSummary": {
      "type": "object",
      "properties": {
        "build_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "candidate_id": {
          "type": "string",
          "minLength": 64,
          "maxLength": 64,
          "pattern": "^[0-9a-f]{64}$"
        },
        "attempt": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295,
          "x-rust-type": "u32"
        },
        "agent_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "provider_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "model_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "tool_name": {
          "const": "submit_knowledge_community"
        },
        "contract_version": {
          "const": 1
        },
        "started_at_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "finished_at_ms": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "latency_ms": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "enum": [
            "running",
            "applied",
            "failed"
          ]
        },
        "failure": {
          "anyOf": [
            {
              "$ref": "native-knowledge.v1.schema.json#/$defs/NativeKnowledgeCommunityFailure"
            },
            {
              "type": "null"
            }
          ]
        },
        "response_digest": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 64,
              "maxLength": 64,
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "build_id",
        "candidate_id",
        "attempt",
        "agent_id",
        "provider_id",
        "model_id",
        "tool_name",
        "contract_version",
        "started_at_ms",
        "finished_at_ms",
        "latency_ms",
        "status",
        "failure",
        "response_digest"
      ],
      "additionalProperties": false
    },
    "NativeKnowledgeCommunityCandidateProgress": {
      "type": "object",
      "properties": {
        "candidate_id": {
          "type": "string",
          "minLength": 64,
          "maxLength": 64,
          "pattern": "^[0-9a-f]{64}$"
        },
        "member_count": {
          "type": "integer",
          "minimum": 2,
          "maximum": 4096
        },
        "job": {
          "$ref": "native-knowledge.v1.schema.json#/$defs/NativeKnowledgeCommunityJobStatus"
        },
        "result": {
          "anyOf": [
            {
              "$ref": "native-knowledge.v1.schema.json#/$defs/NativeKnowledgeCommunityResult"
            },
            {
              "type": "null"
            }
          ]
        },
        "audit": {
          "anyOf": [
            {
              "$ref": "native-knowledge.v1.schema.json#/$defs/NativeKnowledgeCommunityAuditSummary"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "candidate_id",
        "member_count",
        "job",
        "result",
        "audit"
      ],
      "additionalProperties": false
    },
    "NativeKnowledgeCommunityBuildPage": {
      "type": "object",
      "properties": {
        "build": {
          "$ref": "native-knowledge.v1.schema.json#/$defs/NativeKnowledgeCommunityBuildReceipt"
        },
        "status": {
          "$ref": "native-knowledge.v1.schema.json#/$defs/NativeKnowledgeCommunityBuildStatus"
        },
        "current_graph": {
          "type": "boolean"
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "native-knowledge.v1.schema.json#/$defs/NativeKnowledgeCommunityCandidateProgress"
          },
          "minItems": 0,
          "maxItems": 100
        },
        "total": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "offset": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        }
      },
      "required": [
        "build",
        "status",
        "current_graph",
        "items",
        "total",
        "offset",
        "limit"
      ],
      "additionalProperties": false
    },
    "NativeKnowledgeCommunityBuildHistoryPage": {
      "type": "object",
      "properties": {
        "items": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "$ref": "native-knowledge.v1.schema.json#/$defs/NativeKnowledgeCommunityBuildReceipt"
          }
        },
        "total": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "offset": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        }
      },
      "required": [
        "items",
        "total",
        "offset",
        "limit"
      ],
      "additionalProperties": false
    }
  }
}
