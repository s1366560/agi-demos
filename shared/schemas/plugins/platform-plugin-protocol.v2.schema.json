{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.memstack.ai/plugins/platform-plugin-protocol.v2.schema.json",
  "title": "MemStack Platform Plugin Protocol V2",
  "oneOf": [
    { "$ref": "#/$defs/PluginManifestV2" },
    { "$ref": "#/$defs/BundleManifestV2" },
    { "$ref": "#/$defs/ProfileSourceV2" },
    { "$ref": "#/$defs/DesiredBundleSetV2" },
    { "$ref": "#/$defs/ProfileSnapshotV2" },
    { "$ref": "#/$defs/ControlPlaneEnvelopeV2" },
    { "$ref": "#/$defs/SnapshotApplyReceiptV2" }
  ],
  "$defs": {
    "ScopeKindV2": {
      "type": "string",
      "enum": ["root", "tenant", "project", "session"]
    },
    "RuntimeKindV2": {
      "type": "string",
      "enum": ["python-trusted", "rust-native", "wasm", "mcp", "subprocess", "frontend"]
    },
    "TrustKindV2": {
      "type": "string",
      "enum": ["builtin", "signed", "tenant-approved", "untrusted"]
    },
    "RestartPolicyV2": {
      "type": "string",
      "enum": ["hot-generation", "process-boundary"]
    },
    "ApplyStatusV2": {
      "type": "string",
      "enum": ["ack", "nack"]
    },
    "PublicationStatusV2": {
      "type": "string",
      "enum": ["reconciling", "ready", "degraded"]
    },
    "DataPlaneTargetV2": {
      "type": "string",
      "enum": ["python", "rust-server", "desktop-sidecar", "web", "desktop-renderer"]
    },
    "EventModeV2": {
      "type": "string",
      "enum": ["emit", "serial", "bail", "waterfall"]
    },
    "ProfileLayerKindV2": {
      "type": "string",
      "enum": ["bundle", "profile", "tenant", "project", "session"]
    },
    "ScopeV2": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": { "$ref": "#/$defs/ScopeKindV2" },
        "tenant_id": { "type": ["string", "null"], "minLength": 1 },
        "project_id": { "type": ["string", "null"], "minLength": 1 },
        "session_id": { "type": ["string", "null"], "minLength": 1 }
      }
    },
    "QuotaV2": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_wasm_fuel": { "type": "integer", "minimum": 0 },
        "max_wasm_memory_bytes": { "type": "integer", "minimum": 0 },
        "max_wall_time_ms": { "type": "integer", "minimum": 0 },
        "max_concurrent_calls": { "type": "integer", "minimum": 0 },
        "max_output_bytes": { "type": "integer", "minimum": 0 },
        "max_network_requests_per_minute": { "type": "integer", "minimum": 0 },
        "max_storage_bytes": { "type": "integer", "minimum": 0 },
        "max_monthly_usd_micros": { "type": "integer", "minimum": 0 }
      }
    },
    "ArtifactReferenceV2": {
      "type": "object",
      "additionalProperties": false,
      "required": ["digest", "source"],
      "properties": {
        "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "source": { "type": "string", "minLength": 1 },
        "signature": { "type": ["string", "null"] },
        "provenance": { "type": ["string", "null"] }
      }
    },
    "ServiceProvidedV2": {
      "type": "object",
      "additionalProperties": false,
      "required": ["service", "version"],
      "properties": {
        "service": {
          "type": "string",
          "pattern": "^service:[a-z0-9][a-z0-9._:-]{0,255}$"
        },
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+(?:[-+][0-9A-Za-z.-]+)?$"
        }
      }
    },
    "ServiceRequiredV2": {
      "type": "object",
      "additionalProperties": false,
      "required": ["alias", "service", "version"],
      "properties": {
        "alias": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,127}$" },
        "service": {
          "type": "string",
          "pattern": "^service:[a-z0-9][a-z0-9._:-]{0,255}$"
        },
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+(?:[-+][0-9A-Za-z.-]+)?$"
        },
        "contributes": {
          "type": "boolean",
          "description": "When true, this module registers contributions into the required service. Scoped projection includes it when that exact provider is selected."
        }
      }
    },
    "ServiceContractV2": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provides", "requires"],
      "properties": {
        "provides": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/ServiceProvidedV2" }
        },
        "requires": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/ServiceRequiredV2" }
        }
      }
    },
    "JsonSchemaV2": {
      "type": "object"
    },
    "EventContractV2": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event", "mode", "payload_schema", "result_schema"],
      "properties": {
        "event": { "type": "string", "pattern": "^[a-z][a-z0-9._:-]{0,255}$" },
        "mode": { "$ref": "#/$defs/EventModeV2" },
        "payload_schema": { "$ref": "#/$defs/JsonSchemaV2" },
        "result_schema": { "$ref": "#/$defs/JsonSchemaV2" }
      }
    },
    "EventContractsV2": {
      "type": "object",
      "additionalProperties": false,
      "required": ["emits", "handles"],
      "properties": {
        "emits": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/EventContractV2" }
        },
        "handles": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/EventContractV2" }
        }
      }
    },
    "PluginContractV2": {
      "type": "object",
      "additionalProperties": false,
      "required": ["services", "events", "config_schema"],
      "properties": {
        "services": { "$ref": "#/$defs/ServiceContractV2" },
        "events": { "$ref": "#/$defs/EventContractsV2" },
        "config_schema": { "$ref": "#/$defs/JsonSchemaV2" }
      }
    },
    "PluginModuleV2": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "module_ref",
        "entrypoint",
        "artifact",
        "targets",
        "contract",
        "contract_digest"
      ],
      "properties": {
        "module_ref": { "type": "string", "pattern": "^[a-z][a-z0-9+.-]*://.+$" },
        "entrypoint": { "type": "string", "minLength": 1 },
        "artifact": { "$ref": "#/$defs/ArtifactReferenceV2" },
        "targets": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/DataPlaneTargetV2" }
        },
        "contract": { "$ref": "#/$defs/PluginContractV2" },
        "contract_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
      }
    },
    "PluginManifestV2": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "plugin_id",
        "version",
        "runtime",
        "trust",
        "modules",
        "permissions",
        "quotas"
      ],
      "properties": {
        "schema_version": { "const": 2, "type": "integer" },
        "plugin_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$" },
        "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+(?:[-+][0-9A-Za-z.-]+)?$" },
        "runtime": { "$ref": "#/$defs/RuntimeKindV2" },
        "trust": { "$ref": "#/$defs/TrustKindV2" },
        "modules": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/PluginModuleV2" }
        },
        "permissions": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "quotas": { "$ref": "#/$defs/QuotaV2" }
      }
    },
    "ProfileEntryV2": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entry_id",
        "parent_entry_id",
        "plugin_ref",
        "module_ref",
        "enabled",
        "config",
        "inject",
        "isolate",
        "scope",
        "permissions",
        "quotas",
        "restart_policy"
      ],
      "properties": {
        "entry_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$" },
        "parent_entry_id": { "type": ["string", "null"] },
        "plugin_ref": { "type": "string", "minLength": 1 },
        "module_ref": { "type": "string", "pattern": "^[a-z][a-z0-9+.-]*://.+$" },
        "enabled": { "type": "boolean" },
        "config": { "type": "object" },
        "inject": {
          "type": "object",
          "propertyNames": { "pattern": "^[a-z][a-z0-9_]{0,127}$" },
          "additionalProperties": {
            "type": "string",
            "pattern": "^service:[a-z0-9][a-z0-9._:-]{0,255}$"
          }
        },
        "isolate": {
          "type": "object",
          "additionalProperties": { "type": "string", "minLength": 1 }
        },
        "scope": { "$ref": "#/$defs/ScopeV2" },
        "permissions": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "quotas": { "$ref": "#/$defs/QuotaV2" },
        "restart_policy": { "$ref": "#/$defs/RestartPolicyV2" }
      }
    },
    "BundleReferenceV2": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bundle_id", "version", "digest", "source"],
      "properties": {
        "bundle_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
        },
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+(?:[-+][0-9A-Za-z.-]+)?$"
        },
        "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "source": { "type": "string", "minLength": 1 }
      }
    },
    "BundleArtifactV2": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "target", "path", "digest", "size_bytes", "media_type"],
      "properties": {
        "artifact_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
        },
        "target": { "$ref": "#/$defs/DataPlaneTargetV2" },
        "path": { "type": "string", "minLength": 1 },
        "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "size_bytes": { "type": "integer", "minimum": 0 },
        "media_type": { "type": "string", "minLength": 1 }
      }
    },
    "ProfileLayerV2": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "layer_id",
        "kind",
        "scope",
        "entries",
        "replacements",
        "disabled_entry_ids"
      ],
      "anyOf": [
        { "properties": { "entries": { "minItems": 1 } } },
        { "properties": { "replacements": { "minItems": 1 } } },
        { "properties": { "disabled_entry_ids": { "minItems": 1 } } }
      ],
      "properties": {
        "layer_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
        },
        "kind": { "$ref": "#/$defs/ProfileLayerKindV2" },
        "scope": { "$ref": "#/$defs/ScopeV2" },
        "entries": {
          "type": "array",
          "items": { "$ref": "#/$defs/ProfileEntryV2" }
        },
        "replacements": {
          "type": "array",
          "items": { "$ref": "#/$defs/ProfileEntryV2" }
        },
        "disabled_entry_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
          }
        }
      }
    },
    "ProfileSourceV2": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "source_id",
        "profile_id",
        "revision",
        "digest",
        "provenance",
        "layers"
      ],
      "properties": {
        "schema_version": { "const": 2, "type": "integer" },
        "source_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
        },
        "profile_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
        },
        "revision": { "type": "integer", "minimum": 1 },
        "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "provenance": { "type": ["string", "null"], "minLength": 1 },
        "layers": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/ProfileLayerV2" }
        }
      }
    },
    "ProfileSourceReferenceV2": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "revision", "digest"],
      "properties": {
        "source_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
        },
        "revision": { "type": "integer", "minimum": 1 },
        "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
      }
    },
    "BundleManifestV2": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "bundle_id",
        "version",
        "manifests",
        "layers",
        "artifacts",
        "digest",
        "signature",
        "provenance"
      ],
      "properties": {
        "schema_version": { "const": 2, "type": "integer" },
        "bundle_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
        },
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+(?:[-+][0-9A-Za-z.-]+)?$"
        },
        "manifests": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/PluginManifestV2" }
        },
        "layers": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/ProfileLayerV2" }
        },
        "artifacts": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/BundleArtifactV2" }
        },
        "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "signature": { "type": ["string", "null"], "minLength": 1 },
        "provenance": { "type": ["string", "null"], "minLength": 1 }
      }
    },
    "DesiredBundleSetV2": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "desired_set_id",
        "revision",
        "bundles",
        "profile_source",
        "digest"
      ],
      "properties": {
        "schema_version": { "const": 2, "type": "integer" },
        "desired_set_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
        },
        "revision": { "type": "integer", "minimum": 1 },
        "bundles": {
          "type": "array",
          "items": { "$ref": "#/$defs/BundleReferenceV2" }
        },
        "profile_source": { "$ref": "#/$defs/ProfileSourceReferenceV2" },
        "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
      }
    },
    "ProfileSnapshotV2": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "profile_id", "generation", "manifests", "entries", "digest"],
      "properties": {
        "schema_version": { "const": 2, "type": "integer" },
        "profile_id": { "type": "string", "minLength": 1 },
        "generation": { "type": "integer", "minimum": 1 },
        "manifests": {
          "type": "array",
          "items": { "$ref": "#/$defs/PluginManifestV2" }
        },
        "entries": {
          "type": "array",
          "items": { "$ref": "#/$defs/ProfileEntryV2" }
        },
        "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "ControlPlaneEnvelopeV2": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "nonce", "snapshot_digest", "type_url"],
      "properties": {
        "version": { "type": "integer", "minimum": 1 },
        "nonce": { "type": "string", "minLength": 1 },
        "snapshot_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "type_url": { "const": "types.memstack.ai/plugin.profile.v2", "type": "string" }
      }
    },
    "SnapshotApplyReceiptV2": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "requested_version",
        "requested_digest",
        "applied_version",
        "applied_digest",
        "error_code",
        "error_message"
      ],
      "properties": {
        "status": { "$ref": "#/$defs/ApplyStatusV2" },
        "requested_version": { "type": "integer", "minimum": 1 },
        "requested_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "applied_version": { "type": ["integer", "null"], "minimum": 1 },
        "applied_digest": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
        "error_code": { "type": ["string", "null"] },
        "error_message": { "type": ["string", "null"] }
      }
    }
  }
}
