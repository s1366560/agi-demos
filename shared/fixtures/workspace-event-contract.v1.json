  },
  "out_of_scope_event_types": {
    "workspace_plan_updated": "web-only: plan refresh counter in web WorkspaceStore.handlePlanEvent; desktop refreshes plan snapshots through its own sidecar plan channel, not this stream contract.",
    "workspace.presence.joined": "web-only: presence protocol consumed by web WorkspaceStore.handlePresenceEvent; desktop does not participate in the presence protocol.",
    "workspace.presence.left": "web-only: presence protocol consumed by web WorkspaceStore.handlePresenceEvent; desktop does not participate in the presence protocol.",
    "workspace.agent_status.*": "web-only prefix: agent live status handled by web WorkspaceStore.handleAgentStatusEvent; desktop has no equivalent consumer.",
    "workspace.topology.*": "web-only prefix: topology graph mutations handled by web WorkspaceStore.handleTopologyEvent; desktop renders topology through its own surfaces.",
    "blackboard_post_created": "surface-local: web handles blackboard state sync in WorkspaceStore.handleBlackboardEvent while desktop projects the same wire events into a live activity feed (workspaceActivityEventModel); the two consumers have different semantics and are not part of the aligned state contract.",
    "blackboard_post_updated": "surface-local: see blackboard_post_created.",
    "blackboard_post_deleted": "surface-local: see blackboard_post_created.",
    "blackboard_reply_created": "surface-local: see blackboard_post_created.",
    "blackboard_reply_updated": "surface-local: see blackboard_post_created.",
    "blackboard_reply_deleted": "surface-local: see blackboard_post_created.",
    "blackboard_file_created": "surface-local: see blackboard_post_created.",
    "blackboard_file_updated": "surface-local: see blackboard_post_created.",
    "blackboard_file_deleted": "surface-local: see blackboard_post_created.",
    "blackboard_directory_deleted": "surface-local: see blackboard_post_created.",
    "topology_updated": "surface-local: desktop projects topology updates into its live activity feed; web handles topology graph state separately."
  }
}
