{
  "schema_version": "1.0.0",
  "contract": "cross-platform-workspace-websocket-event-types",
  "description": "Single source of truth for workspace WebSocket event types that MUST stay aligned between the desktop client (agi-stack/apps/desktop) and the web client (web/). Any single-sided addition, rename, or removal of an event type in this contract must be caught by the contract tests on both ends: agi-stack/apps/desktop/tests/workspace-cross-platform-event-contract.test.mjs and web/src/test/stores/workspaceEventContract.test.ts.",
  "shared_context": {
    "workspace_id": "ws-contract-1",
    "tenant_id": "tenant-contract-1",
    "project_id": "project-contract-1"
  },
  "families": {
    "message": {
      "description": "Workspace chat message stream events consumed by desktop workspaceMessageEventModel and web WorkspaceStore.handleChatEvent.",
      "event_types": ["workspace_message_created"]
    },
    "task": {
      "description": "Workspace task stream events consumed by desktop workspaceTaskEventModel and web WorkspaceStore.handleTaskEvent.",
      "event_types": [
        "workspace_task_created",
        "workspace_task_updated",
        "workspace_task_deleted",
        "workspace_task_status_changed",
        "workspace_task_assigned"
      ]
    },
    "member": {
      "description": "Workspace member roster events consumed by desktop workspaceRosterEventModel and web WorkspaceStore.handleMemberEvent.",
      "event_types": [
        "workspace_member_joined",
        "workspace_member_updated",
        "workspace_member_left"
      ]
    },
    "agent_binding": {
      "description": "Workspace agent binding roster events consumed by desktop workspaceRosterEventModel and web WorkspaceStore.handleAgentBindingEvent.",
      "event_types": ["workspace_agent_bound", "workspace_agent_unbound"]
    },
    "lifecycle": {
      "description": "Workspace lifecycle events consumed by desktop workspaceLifecycleEventModel and web WorkspaceStore.handleWorkspaceLifecycleEvent.",
      "event_types": ["workspace_updated", "workspace_deleted"]
    }
  },
  "sample_events": {
