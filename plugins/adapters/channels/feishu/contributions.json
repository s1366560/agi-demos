{
  "schema": "memstack.plugin.contributions/1",
  "tools": [{
    "name": "render_timeline", "abi": "invoke",
    "input_schema": {
      "type": "object",
      "properties": {
        "event": {"enum": ["task_start", "task_complete"]},
        "status": {"type": "string", "maxLength": 128},
        "order_index": {"type": "integer", "minimum": 0, "maximum": 4294967295},
        "total_tasks": {"type": "integer", "minimum": 0, "maximum": 4294967295}
      },
      "required": ["event", "status", "order_index", "total_tasks"],
      "additionalProperties": false
    },
    "output_schema": {"type":"object", "properties":{"prefix":{"type":"string", "maxLength":1024}}, "required":["prefix"], "additionalProperties":false},
    "permissions": ["tools.execute"]
  }]
}
