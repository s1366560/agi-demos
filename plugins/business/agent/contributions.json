{
  "schema": "memstack.plugin.contributions/1",
  "subagents": [
    {
      "id": "skill-format-reviewer",
      "name": "Skill format reviewer",
      "description": "Review the structure of a supplied SKILL.md document.",
      "instructions": "Use the package validation tool on the SKILL.md text supplied by the requester. Report its structural errors and warnings with the affected fields. If the document is missing, request its contents.",
      "tools": [
        "validate_skill"
      ],
      "permissions": [
        "subagents.register"
      ]
    }
  ],
  "tools": [
    {
      "name": "validate_skill",
      "abi": "mcp.stdio",
      "description": "Check one SKILL.md document and return structural validation errors and warnings.",
      "input_schema": {
        "type": "object",
        "properties": {
          "content": {
            "type": "string",
            "maxLength": 32768
          },
          "strict": {
            "type": "boolean"
          }
        },
        "required": [
          "content"
        ],
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "is_valid": {
            "type": "boolean"
          },
          "skill_name": {
            "type": [
              "string",
              "null"
            ]
          },
          "errors": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "warnings": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "error_count": {
            "type": "integer"
          },
          "warning_count": {
            "type": "integer"
          }
        },
        "required": [
          "is_valid",
          "skill_name",
          "errors",
          "warnings",
          "error_count",
          "warning_count"
        ],
        "additionalProperties": false
      },
      "permissions": [
        "tools.execute"
      ]
    },
    {
      "name": "execution_statistics",
      "abi": "mcp.stdio",
      "input_schema": {
        "type": "object",
        "properties": {
          "events": {
            "type": "array",
            "maxItems": 1000,
            "items": {
              "type": "array",
              "minItems": 4,
              "maxItems": 4,
              "items": {
                "type": [
                  "integer",
                  "null"
                ]
              }
            }
          }
        },
        "required": [
          "events"
        ],
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "tool_counts": {
            "type": "array",
            "maxItems": 1000,
            "items": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": {
                "type": "integer",
                "minimum": 0
              }
            }
          },
          "status_counts": {
            "type": "array",
            "maxItems": 1000,
            "items": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": {
                "type": "integer",
                "minimum": 0
              }
            }
          },
          "time_buckets": {
            "type": "array",
            "maxItems": 1000,
            "items": {
              "type": "array",
              "minItems": 4,
              "maxItems": 4,
              "items": {
                "type": "integer",
                "minimum": 0
              }
            }
          },
          "average_duration_ms": {
            "type": "number"
          },
          "completed_count": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000
          },
          "failed_count": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000
          }
        },
        "required": [
          "tool_counts",
          "status_counts",
          "time_buckets",
          "average_duration_ms",
          "completed_count",
          "failed_count"
        ],
        "additionalProperties": false
      },
      "permissions": [
        "tools.execute"
      ]
    },
    {
      "name": "react_loop",
      "abi": "mcp.stdio",
      "description": "Select the next ReAct operation from the turn continuation.",
      "permissions": [
        "agent.loop.drive",
        "tools.execute"
      ],
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "phase": {
            "type": "string",
            "enum": [
              "start",
              "stepped",
              "judged",
              "observed",
              "restart"
            ]
          },
          "outcome": {
            "type": "string",
            "enum": [
              "continue",
              "stop",
              "complete",
              "compact"
            ]
          },
          "steps": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "phase",
          "outcome",
          "steps"
        ]
      },
      "output_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "step",
              "judge",
              "observe",
              "finish",
              "stop"
            ]
          }
        },
        "required": [
          "action"
        ]
      }
    }
  ],
  "commands": [
    {
      "id": "validate-skill",
      "tool": "validate_skill",
      "payload": {
        "content": "---\nname: example\ndescription: Validate the document structure.\n---\n# Example"
      },
      "permissions": [
        "tools.execute"
      ],
      "accepts_input": true
    },
    {
      "id": "chat-list",
      "host_operation": "app.agent.list",
      "payload": {},
      "accepts_input": true,
      "permissions": [
        "app.agent.list"
      ]
    },
    {
      "id": "chat-create",
      "host_operation": "app.agent.create",
      "payload": {},
      "accepts_input": true,
      "permissions": [
        "app.agent.create"
      ]
    },
    {
      "id": "chat-history",
      "host_operation": "app.agent.history",
      "payload": {},
      "accepts_input": true,
      "permissions": [
        "app.agent.history"
      ]
    },
    {
      "id": "chat-turn",
      "host_operation": "app.agent.turn",
      "payload": {},
      "accepts_input": true,
      "permissions": [
        "app.agent.turn"
      ]
    },
    {
      "id": "chat-cancel",
      "host_operation": "app.agent.cancel",
      "payload": {},
      "accepts_input": true,
      "permissions": [
        "app.agent.cancel"
      ]
    },
    {
      "id": "chat-rename",
      "host_operation": "app.agent.rename",
      "payload": {},
      "accepts_input": true,
      "permissions": [
        "app.agent.rename"
      ]
    }
  ],
  "ui": [
    {
      "slot": "settings_page",
      "path": "ui/settings.json",
      "digest": "sha256:58d59bbfdaa53b34d570201ae5ca87952af68976d2721189349de6dc44f1db6a",
      "targets": [
        "web",
        "desktop-renderer"
      ],
      "permissions": [
        "ui.slot"
      ]
    }
  ],
  "pages": [
    {
      "id": "skill",
      "title": "Agent skills",
      "routes": [
        "/agent/skills"
      ],
      "targets": [
        "web",
        "desktop-renderer"
      ],
      "entry": {
        "path": "ui/skill.js",
        "digest": "sha256:e23700c885031b17840724f53b4225fd150e340f6566a15023b10b8a8059cb82"
      },
      "commands": [
        "validate-skill"
      ],
      "device_tools": []
    },
    {
      "id": "chat",
      "home": true,
      "title": "Agent chat",
      "routes": [
        "/agent/chat",
        "/tenant/:tenantId/agent-workspace",
        "/tenant/:tenantId/agent-workspace/:conversationId",
        "/agent/chat/:conversationId"
      ],
      "targets": [
        "web",
        "desktop-renderer"
      ],
      "entry": {
        "path": "ui/chat.js",
        "digest": "sha256:23fbfee3586affe3fe14c933cc90fa61dce1f2bee51b612834d40e700c4d7e93"
      },
      "commands": [
        "chat-list",
        "chat-create",
        "chat-history",
        "chat-turn",
        "chat-cancel",
        "chat-rename"
      ],
      "device_tools": [
        "local_chat"
      ],
      "resources": [
        {
          "path": "ui/transcript.js",
          "digest": "sha256:90a3a23374c23c2cc6a95d22ab9d52454c5e4e70be419ef704bbc0c52ce8000e"
        }
      ],
      "style": {
        "path": "ui/chat.css",
        "digest": "sha256:ae12539eb0a74174976a98889c7d164f40a7864ef860562faaf3120bbce8d9c1"
      }
    }
  ]
}
