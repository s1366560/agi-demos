{
  "schema": "memstack.plugin.contributions/1",
  "tools": [
    {
      "name": "cluster_health",
      "abi": "mcp.stdio",
      "description": "Project node count and CPU and memory utilization from supplied cluster statistics.",
      "permissions": [
        "tools.execute"
      ],
      "input_schema": {
        "type": "object",
        "properties": {
          "total_nodes": {
            "type": "number",
            "minimum": 0
          },
          "node_count": {
            "type": "number",
            "minimum": 0
          },
          "nodes": {
            "type": "number",
            "minimum": 0
          },
          "cpu_usage": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "used_cpu": {
            "type": "number"
          },
          "total_cpu": {
            "type": "number"
          },
          "memory_usage": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "used_memory_gb": {
            "type": "number"
          },
          "total_memory_gb": {
            "type": "number"
          }
        },
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "node_count": {
            "type": "integer",
            "minimum": 0
          },
          "cpu_usage": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 100
          },
          "memory_usage": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 100
          }
        },
        "required": [
          "node_count",
          "cpu_usage",
          "memory_usage"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "patch_text",
      "description": "Apply a single-file unified diff to supplied text using the sandbox patch engine.",
      "abi": "mcp.stdio",
      "input_schema": {
        "type": "object",
        "properties": {
          "content": {
            "type": "string",
            "maxLength": 8192
          },
          "patch": {
            "type": "string",
            "maxLength": 8192
          }
        },
        "required": [
          "content",
          "patch"
        ],
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "content": {
            "type": "string"
          }
        },
        "required": [
          "content"
        ],
        "additionalProperties": false
      },
      "permissions": [
        "tools.execute"
      ]
    }
  ],
  "commands": [
    {
      "id": "cluster-health",
      "tool": "cluster_health",
      "payload": {
        "total_nodes": 2,
        "total_cpu": 4,
        "used_cpu": 1
      },
      "permissions": [
        "tools.execute"
      ],
      "accepts_input": true
    },
    {
      "id": "patch-text",
      "tool": "patch_text",
      "permissions": [
        "tools.execute"
      ],
      "payload": {
        "content": "",
        "patch": ""
      },
      "accepts_input": true
    },
    {
      "id": "sandbox-status",
      "host_operation": "app.environments.sandbox.read",
      "permissions": [
        "app.environments.sandbox.read"
      ],
      "payload": {},
      "accepts_input": true
    },
    {
      "id": "prepare-sandbox",
      "host_operation": "app.environments.sandbox.prepare",
      "permissions": [
        "app.environments.sandbox.prepare"
      ],
      "payload": {},
      "accepts_input": true
    },
    {
      "id": "authorize-run-terminal",
      "host_operation": "app.environments.terminal.authorize",
      "permissions": [
        "app.environments.terminal.authorize"
      ],
      "payload": {},
      "accepts_input": true
    }
  ],
  "ui": [
    {
      "slot": "settings_page",
      "path": "ui/settings.json",
      "digest": "sha256:003d111eada076fdf2a0a4ca69f0fe7a6b726e24b2169e1f24d9920e31b65d23",
      "targets": [
        "web",
        "desktop-renderer"
      ],
      "permissions": [
        "ui.slot"
      ]
    }
  ],
  "pages": [
    {
      "id": "sandbox",
      "title": "Project sandbox",
      "routes": [
        "/environments/sandbox",
        "/tenant/:tenantId/project/:projectId/sandbox"
      ],
      "targets": [
        "web",
        "desktop-renderer"
      ],
      "entry": {
        "path": "ui/sandbox.js",
        "digest": "sha256:ecccf897bab222c728edb84ea23849e8b99281c43de1c9ae761453e6c390e972"
      },
      "commands": [
        "sandbox-status",
        "prepare-sandbox",
        "authorize-run-terminal"
      ],
      "device_tools": []
    },
    {
      "id": "patch",
      "title": "Sandbox patch preview",
      "routes": [
        "/environments/patch"
      ],
      "targets": [
        "web",
        "desktop-renderer"
      ],
      "entry": {
        "path": "ui/patch.js",
        "digest": "sha256:1bd26fc558664e4e4a26cd07d823c261a6adb144016adb4bb03a16c421964d26"
      },
      "commands": [
        "patch-text"
      ],
      "device_tools": []
    }
  ]
}
