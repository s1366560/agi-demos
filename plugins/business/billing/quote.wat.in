(module
  (memory (export "memory") 3 3)
  ;; The request and response reside at the SDK's fixed offsets 0 and 65536.
  ;; Reference data lives on the third page.
  (func $matches (param $length i32) (param $reference i32) (param $expected i32) (result i32)
    (local $index i32)
    (if (i32.ne (local.get $length) (local.get $expected))
      (then (return (i32.const 0))))
    (loop $next
      (if (i32.eq (local.get $index) (local.get $length))
        (then (return (i32.const 1))))
      (if (i32.ne
        (i32.load8_u (local.get $index))
        (i32.load8_u (i32.add (local.get $reference) (local.get $index))))
        (then (return (i32.const 0))))
      (local.set $index (i32.add (local.get $index) (i32.const 1)))
      (br $next))
    (i32.const 0))
  {data}
  (func (export "invoke") (param $length i32) (result i32)
    {cases}
    {unknown}))
