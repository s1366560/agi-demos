{
  "schema": "memstack.plugin.contributions/1",
  "tools": [
    {
      "name": "quote",
      "abi": "invoke",
      "permissions": [
        "tools.execute"
      ],
      "input_schema": {
        "type": "object",
        "properties": {
          "plan": {
            "enum": [
              "free",
              "pro",
              "enterprise"
            ]
          }
        },
        "required": [
          "plan"
        ],
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "plan": {
            "type": "string"
          },
          "storage_limit": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "plan",
          "storage_limit"
        ],
        "additionalProperties": false
      }
    }
  ],
  "commands": [
    {
      "id": "quote-free",
      "tool": "quote",
      "permissions": [
        "tools.execute"
      ],
      "payload": {
        "plan": "free"
      },
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "plan": {
            "const": "free"
          }
        },
        "required": [
          "plan"
        ]
      },
      "output_schema": {
        "type": "object"
      }
    },
    {
      "id": "quote-pro",
      "tool": "quote",
      "permissions": [
        "tools.execute"
      ],
      "payload": {
        "plan": "pro"
      },
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "plan": {
            "const": "pro"
          }
        },
        "required": [
          "plan"
        ]
      },
      "output_schema": {
        "type": "object"
      }
    },
    {
      "id": "quote-enterprise",
      "tool": "quote",
      "permissions": [
        "tools.execute"
      ],
      "payload": {
        "plan": "enterprise"
      },
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "plan": {
            "const": "enterprise"
          }
        },
        "required": [
          "plan"
        ]
      },
      "output_schema": {
        "type": "object"
      }
    },
    {
      "id": "tenant-account",
      "host_operation": "app.billing.account.read",
      "payload": {},
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {}
      },
      "permissions": [
        "app.billing.account.read"
      ],
      "accepts_input": false,
      "output_schema": {
        "type": "object"
      }
    },
    {
      "id": "change-plan",
      "host_operation": "app.billing.plan.write",
      "payload": {},
      "input_schema": {
        "type": "object"
      },
      "permissions": [
        "app.billing.plan.write"
      ],
      "accepts_input": true,
      "output_schema": {
        "type": "object"
      }
    },
    {
      "id": "billing-details",
      "host_operation": "app.billing.account.read",
      "payload": {
        "full_history": true
      },
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "full_history": {
            "const": true
          }
        },
        "required": [
          "full_history"
        ]
      },
      "permissions": [
        "app.billing.account.read"
      ],
      "accepts_input": false,
      "output_schema": {
        "type": "object"
      }
    }
  ],
  "ui": [
    {
      "slot": "settings_page",
      "path": "ui/settings.json",
      "digest": "sha256:bf79751e68f0c6d93e16839436b9450c7276690ae4cd7e3e4679136b11268521",
      "targets": [
        "web",
        "desktop-renderer"
      ],
      "permissions": [
        "ui.slot"
      ]
    }
  ],
  "pages": [
    {
      "id": "account",
      "title": "Plans and invoices",
      "routes": [
        "/billing"
      ],
      "targets": [
        "web",
        "desktop-renderer"
