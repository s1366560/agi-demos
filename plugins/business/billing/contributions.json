{
  "schema": "memstack.plugin.contributions/1",
  "tools": [
    {
      "name": "quote",
      "abi": "invoke",
      "permissions": [
        "tools.execute"
      ],
      "input_schema": {
        "type": "object",
        "properties": {
          "plan": {
            "enum": [
              "free",
              "pro",
              "enterprise"
            ]
          }
        },
        "required": [
          "plan"
        ],
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "plan": {
            "type": "string"
          },
          "storage_limit": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "plan",
          "storage_limit"
        ],
        "additionalProperties": false
      }
    }
  ],
  "commands": [
    {
      "id": "quote-free",
      "tool": "quote",
      "permissions": [
        "tools.execute"
      ],
      "payload": {
        "plan": "free"
      }
    },
    {
      "id": "quote-pro",
      "tool": "quote",
      "permissions": [
        "tools.execute"
      ],
      "payload": {
        "plan": "pro"
      }
    },
    {
      "id": "quote-enterprise",
      "tool": "quote",
      "permissions": [
        "tools.execute"
      ],
      "payload": {
        "plan": "enterprise"
      }
    }
  ],
  "ui": [
    {
      "slot": "settings_page",
      "path": "ui/settings.json",
      "digest": "sha256:bf79751e68f0c6d93e16839436b9450c7276690ae4cd7e3e4679136b11268521",
      "targets": [
        "web",
        "desktop-renderer"
      ],
      "permissions": [
        "ui.slot"
      ]
    }
  ],
  "pages": [
    {
      "id": "account",
      "title": "Plans and invoices",
      "routes": [
        "/billing"
      ],
      "targets": [
        "web",
        "desktop-renderer"
      ],
      "entry": {
        "path": "ui/account.js",
        "digest": "sha256:e245d29274d5740c50ca8835cf50daab9d11ef4c8d2200101ca18eda14345a0e"
      },
      "commands": [
        "quote-free",
        "quote-pro",
        "quote-enterprise"
      ],
      "device_tools": []
    }
  ]
}
