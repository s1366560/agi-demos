        "digest": "sha256:53489796bf8a29133b797184542251c116b3247719fb666dbd5da27d499f9984"
      },
      "commands": [
        "billing-details",
        "change-plan"
      ],
      "device_tools": [],
      "scope": "tenant",
      "workbench": true,
      "style": {
