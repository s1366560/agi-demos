{
  "schema": "memstack.plugin.contributions/1",
  "tools": [
    {
      "name": "export_csv",
      "abi": "invoke",
      "input_schema": {
        "type": "object",
        "properties": {
          "header": {
            "type": "boolean"
          },
          "rows": {
            "type": "array",
            "maxItems": 8,
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "maxLength": 128
                },
                "name": {
                  "type": "string",
                  "maxLength": 255
                },
                "office_status": {
                  "type": "string",
                  "maxLength": 128
                },
                "is_archived": {
                  "type": "boolean"
                }
              },
              "required": [
                "id",
                "name",
                "office_status",
                "is_archived"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "header",
          "rows"
        ],
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "csv": {
            "type": "string",
            "maxLength": 65536
          }
        },
        "required": [
          "csv"
        ],
        "additionalProperties": false
      },
      "permissions": [
        "tools.execute"
      ]
    }
  ],
