{
  "schema": "memstack.plugin.contributions/1",
  "tools": [
    {
      "name": "export_csv",
      "abi": "invoke",
      "input_schema": {
        "type": "object",
        "properties": {
          "header": {
            "type": "boolean"
          },
          "rows": {
            "type": "array",
            "maxItems": 8,
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "maxLength": 128
                },
                "name": {
                  "type": "string",
                  "maxLength": 255
                },
                "office_status": {
                  "type": "string",
                  "maxLength": 128
                },
                "is_archived": {
                  "type": "boolean"
                }
              },
              "required": [
                "id",
                "name",
                "office_status",
                "is_archived"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "header",
          "rows"
        ],
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "csv": {
            "type": "string",
            "maxLength": 65536
          }
        },
        "required": [
          "csv"
        ],
        "additionalProperties": false
      },
      "permissions": [
        "tools.execute"
      ]
    }
  ],
  "commands": [
    {
      "id": "export-csv",
      "tool": "export_csv",
      "payload": {
        "header": true,
        "rows": []
      },
      "permissions": [
        "tools.execute"
      ],
      "accepts_input": true
    },
    {
      "id": "list-directory",
      "host_operation": "app.workspace.directory.read",
      "permissions": [
        "app.workspace.directory.read"
      ],
      "payload": {},
      "accepts_input": true
    },
    {
      "id": "read-workspace",
      "host_operation": "app.workspace.detail.read",
      "permissions": [
        "app.workspace.detail.read"
      ],
      "payload": {},
      "accepts_input": true
    }
  ],
  "ui": [
    {
      "slot": "settings_page",
      "path": "ui/settings.json",
      "digest": "sha256:a62f5e554a80c0bfca7880caa5edbb4cc6c4728b0f3b6ea475e6c142f0fecc47",
      "targets": [
        "web",
        "desktop-renderer"
      ],
      "permissions": [
        "ui.slot"
      ]
    }
  ],
  "pages": [
    {
      "id": "directory",
      "title": "Workspace directory",
      "routes": [
        "/workspaces",
        "/tenant/:tenantId/project/:projectId/workspaces"
      ],
      "targets": [
        "web",
        "desktop-renderer"
      ],
      "entry": {
        "path": "ui/directory.js",
        "digest": "sha256:76e8d20edff83bc0a702d4c013e6b6075e6760e870a032af6296e69182d74ec6"
      },
      "commands": [
        "export-csv",
        "list-directory"
      ],
      "device_tools": [],
      "style": {
        "path": "ui/directory.css",
        "digest": "sha256:a0eb0bb18956a450e8ac13cf5d0f1f40f8facaf1a08db29f36f02a20b6370d2e"
      }
    },
    {
      "id": "overview",
      "title": "Project overview",
      "routes": [
        "/workspace/overview",
        "/tenant/:tenantId/project/:projectId"
      ],
      "targets": [
        "web",
        "desktop-renderer"
      ],
      "commands": [
        "list-directory"
      ],
      "entry": {
        "path": "ui/overview.js",
        "digest": "sha256:d3bbbd3fd6cd908ff842e540ea211251bf8c427fc7a475fdf82d6257ba67dbc6"
      },
      "device_tools": []
    },
    {
      "id": "detail",
      "title": "Workspace details",
      "routes": [
        "/workspaces/:workspaceId",
        "/tenant/:tenantId/project/:projectId/workspaces/:workspaceId"
      ],
      "targets": [
        "web",
        "desktop-renderer"
      ],
      "commands": [
        "read-workspace"
      ],
      "entry": {
        "path": "ui/overview.js",
        "digest": "sha256:d3bbbd3fd6cd908ff842e540ea211251bf8c427fc7a475fdf82d6257ba67dbc6"
      },
      "device_tools": []
    }
  ]
}
