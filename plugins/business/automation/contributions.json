              "properties": {
                "next_run_at": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "required": [
                "next_run_at"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "results"
        ],
        "additionalProperties": false
      },
      "permissions": [
        "tools.execute"
      ]
    },
    {
      "name": "save_schedule_workflow",
      "abi": "mcp.stdio",
      "input_schema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[0-9a-f]{32}$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "expected_revision": {
            "type": "integer",
            "minimum": 0,
            "maximum": 999999998
          },
          "intervals": {
            "type": "array",
            "minItems": 1,
            "maxItems": 16,
            "items": {
              "type": "integer",
              "minimum": 1,
              "maximum": 31536000
            }
          }
        },
        "required": [
          "id",
          "name",
          "expected_revision",
          "intervals"
        ],
        "additionalProperties": false
