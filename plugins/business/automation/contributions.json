      "input_schema": {
        "type": "object",
        "properties": {
          "steps": {
            "type": "array",
            "minItems": 1,
            "maxItems": 16,
            "items": {
              "type": "object",
              "properties": {
                "kind": {
                  "enum": [
                    "at",
                    "every",
                    "cron"
                  ]
                },
                "config": {
                  "type": "object",
                  "properties": {
                    "run_at": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 64
                    },
                    "interval_seconds": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 315576000
                    },
                    "expr": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 256
                    },
                    "timezone": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 128
                    }
                  },
                  "required": [],
                  "additionalProperties": false
                },
                "timezone": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                },
                "start": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64
                }
              },
              "required": [
                "kind",
                "config",
                "start"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "steps"
        ],
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "results": {
            "type": "array",
            "maxItems": 16,
            "items": {
              "type": "object",
              "properties": {
                "next_run_at": {
                  "type": [
                    "string",
                    "null"
                  ]
