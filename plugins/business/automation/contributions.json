              "run_at": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
              "interval_seconds": {
                "type": "integer",
                "minimum": 1,
                "maximum": 315576000
              },
              "expr": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "timezone": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              }
            },
            "required": [],
            "additionalProperties": false
          },
          "timezone": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "start": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          }
