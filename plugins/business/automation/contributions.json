      "output_schema": {
        "type": "object",
        "properties": {
          "saved": {
            "type": "boolean"
          },
          "revision": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "saved",
          "revision"
        ],
        "additionalProperties": false
      },
      "permissions": [
        "tools.execute",
        "storage.read",
        "storage.write"
      ]
    },
