        "required": [],
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "maxItems": 16,
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{32}$"
                },
                "revision": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 999999999
                },
                "name": {
                  "type": "string",
