    "postinstall": "wxt prepare",
    "test": "vitest run --exclude scripts/browser-release-contract.test.mjs && node --test scripts/browser-release-contract.test.mjs",
    "test:snapshot": "node scripts/test-snapshot.mjs",
    "test:bridge": "node scripts/smoke-bridge.mjs",
    "release:verify": "node scripts/browser-release-contract.mjs verify",
