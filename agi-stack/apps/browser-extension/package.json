{
  "name": "@memstack/browser-extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.15.1+sha512.81350b07e53c9538a02f1f2303b4290fa2d7be04e56e2a970c4cc4b417dc761de196edabd49d55c7dc9580db81007c44143e4e3d7e462b3000d23c255122d065",
  "description": "MemStack Browser Bridge \u2014 MV3 extension relaying CDP to the MemStack desktop sidecar.",
  "scripts": {
    "dev": "wxt",
