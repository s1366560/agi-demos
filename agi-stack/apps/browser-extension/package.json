    "enterprise:generate": "node scripts/browser-release-contract.mjs generate-policy"
  },
  "dependencies": {
    "typescript": "^5.9.3",
    "vitest": "^4.1.10",
    "wxt": "^0.21.3"
  },
  "devDependencies": {
    "playwright": "1.57.0"
  }
}
