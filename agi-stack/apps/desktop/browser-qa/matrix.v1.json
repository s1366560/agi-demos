{
  "contractVersion": 1,
  "scenarioPattern": "../qa/*.html",
  "locales": [
    {
      "id": "en-US",
      "storageValue": "en",
      "documentLanguage": "en"
    },
    {
      "id": "zh-CN",
      "storageValue": "zh-CN",
      "documentLanguage": "zh-CN"
    }
  ],
  "viewports": [
    {
      "id": "desktop-wide",
      "width": 1440,
      "height": 1024
    },
    {
      "id": "desktop-compact",
      "width": 1100,
      "height": 800
    }
  ],
  "themes": [
    "light",
    "dark"
  ],
  "scenarioVariants": {
    "session-steering": [
      { "id": "default", "query": {} },
      { "id": "a2ui-ready", "query": { "a2ui-canvas-events": "1" } },
      {
        "id": "a2ui-incremental",
        "query": { "a2ui-canvas-incremental": "1" }
      },
      { "id": "a2ui-deleted", "query": { "a2ui-canvas-deleted": "1" } },
      { "id": "hitl-answered", "query": { "hitl-response-events": "1" } },
      { "id": "elicitation", "query": { "elicitation-events": "1" } }
    ],
    "workspace-collaboration": [
      { "id": "ready", "query": { "state": "ready" } },
      { "id": "loading", "query": { "state": "loading" } },
      { "id": "empty", "query": { "state": "empty" } },
      { "id": "stale", "query": { "state": "stale" } },
      { "id": "error", "query": { "state": "error" } }
    ],
    "sandbox-runtime": [
      { "id": "ready", "query": { "state": "ready" } },
      { "id": "loading", "query": { "state": "loading" } },
      { "id": "unavailable", "query": { "state": "unavailable" } },
      { "id": "stale", "query": { "state": "stale" } },
      { "id": "error", "query": { "state": "error" } }
    ]
  },
  "checks": [
    "page-error",
    "console-error",
    "horizontal-overflow",
    "bare-i18n-key",
    "keyboard-order",
    "focus-return",
    "aria"
  ]
}
