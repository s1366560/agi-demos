{
  "name": "agistack-desktop-ui",
  "version": "0.1.0",
  "description": "MemStack Mission Control desktop client.",
  "author": "MemStack",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "packageManager": "pnpm@11.15.1",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.15.1",
      "onFail": "warn"
    }
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "dev:electron": "electron-vite dev --watch",
    "build:sidecar": "cargo build --manifest-path sidecar/Cargo.toml --release",
    "stage:sidecar": "node scripts/stage-sidecar.mjs",
    "test": "node tests/run.mjs",
    "build": "tsc --noEmit && vite build",
    "build:electron": "tsc --noEmit && tsc --noEmit -p tsconfig.electron.json && electron-vite build",
    "qa:browser": "playwright test --config browser-qa/playwright.config.mjs",
    "qa:paired-production": "node browser-qa/run-paired-production.mjs",
    "package:electron": "corepack pnpm run build:electron && corepack pnpm run build:sidecar && corepack pnpm run stage:sidecar && corepack pnpm exec electron-builder --config electron-builder.local.yml --publish never",
    "release:electron": "corepack pnpm run build:electron && corepack pnpm run build:sidecar && corepack pnpm run stage:sidecar && corepack pnpm exec electron-builder --publish never",
    "preview": "vite preview --host 127.0.0.1",
    "preview:electron": "electron-vite preview"
  },
  "dependencies": {
    "@copilotkit/a2ui-renderer": "1.53.0",
    "@mcp-ui/client": "^6.1.1",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/themes": "^3.3.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "cmdk": "^1.1.1",
    "docx-preview": "0.3.7",
    "electron-updater": "6.8.9",
    "highlight.js": "^11.11.1",
    "html2pdf.js": "^0.14.0",
    "katex": "^0.16.28",
    "mermaid": "^11.12.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "xlsx": "0.18.5",
    "yaml": "2.8.1"
  },
  "devDependencies": {
    "@playwright/test": "1.57.0",
    "@types/node": "^22.19.15",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.4",
    "electron": "^43.2.0",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "typescript": "^6.0.3",
    "vite": "^7.3.1"
  }
}
