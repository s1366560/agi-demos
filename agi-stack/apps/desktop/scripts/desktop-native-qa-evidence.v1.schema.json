{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Desktop external native QA evidence v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "version",
    "tag",
    "commit_sha",
    "source_index_sha256",
    "workflow_run",
    "checks",
    "promotion_status"
  ],
  "properties": {
    "contract_version": { "const": "desktop-native-qa-evidence-v1" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$" },
    "tag": { "type": "string", "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$" },
    "commit_sha": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "source_index_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "workflow_run": { "$ref": "#/$defs/workflowRun" },
    "checks": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": { "$ref": "#/$defs/check" }
    },
    "promotion_status": { "enum": ["passed", "blocked"] }
  },
  "$defs": {
    "workflowRun": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "attempt", "url"],
      "properties": {
        "id": { "type": "string", "pattern": "^[1-9][0-9]*$" },
        "attempt": { "type": "string", "pattern": "^[1-9][0-9]*$" },
        "url": { "type": "string", "pattern": "^https://github\\.com/" }
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "status", "evidence_sha256", "evidence_url"],
      "properties": {
        "id": { "type": "string", "minLength": 3 },
        "status": { "enum": ["passed", "blocked"] },
        "evidence_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "evidence_url": { "type": "string", "pattern": "^https://github\\.com/" }
      }
    }
  }
}
