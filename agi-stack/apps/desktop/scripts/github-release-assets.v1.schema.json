{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Live GitHub release asset manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "tag", "assets"],
  "properties": {
    "contract_version": { "const": "github-release-assets-v1" },
    "tag": {
      "type": "string",
      "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"
    },
    "assets": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/asset" }
    }
  },
  "$defs": {
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["github_asset_id", "name", "size", "digest"],
      "properties": {
        "github_asset_id": { "type": "string", "pattern": "^[1-9][0-9]*$" },
        "name": { "type": "string", "pattern": "^[A-Za-z0-9_.-]{1,240}$" },
        "size": { "type": "number", "exclusiveMinimum": 0 },
        "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
      }
    }
  }
}
