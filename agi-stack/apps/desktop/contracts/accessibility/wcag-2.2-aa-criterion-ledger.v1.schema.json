{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "wcag-2.2-aa-criterion-ledger.v1.schema.json",
  "title": "MemStack WCAG 2.2 A and AA criterion ledger",
  "type": "object",
  "required": [
    "$schema",
    "schema_version",
    "record_kind",
    "standard",
    "source_revision",
    "route_contract",
    "assessment_defaults",
    "criteria",
    "assessments",
    "route_coverage"
  ],
  "properties": {
    "$schema": { "type": "string", "minLength": 1 },
    "schema_version": { "const": "1.0.0" },
    "record_kind": { "enum": ["template", "evidence"] },
    "standard": { "const": "WCAG 2.2 A and AA" },
    "source_revision": { "type": "string", "minLength": 1 },
    "generated_at": { "type": ["string", "null"] },
    "route_contract": {
      "type": "object",
      "required": ["path", "source_revision"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "source_revision": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "assessment_defaults": {
      "type": "object",
      "required": ["web", "desktop_browser_qa", "browser_extension", "native_electron"],
      "properties": {
        "web": { "$ref": "#/$defs/defaultAssessment" },
        "desktop_browser_qa": { "$ref": "#/$defs/defaultAssessment" },
        "browser_extension": { "$ref": "#/$defs/defaultAssessment" },
        "native_electron": { "$ref": "#/$defs/defaultAssessment" }
      },
      "additionalProperties": false
    },
    "criteria": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/criterion" }
    },
    "assessments": {
      "type": "array",
      "items": { "$ref": "#/$defs/assessment" }
    },
    "route_coverage": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": { "$ref": "#/$defs/routeCoverage" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "surface": {
      "enum": ["web", "desktop_browser_qa", "browser_extension", "native_electron"]
    },
    "status": {
      "enum": ["passed", "failed", "not_run", "blocked"]
    },
    "method": {
      "enum": ["axe", "state_contract", "hybrid", "manual_at"]
    },
    "defaultAssessment": {
      "type": "object",
      "required": ["status", "blocker_reason"],
      "properties": {
        "status": { "enum": ["not_run", "blocked"] },
        "blocker_reason": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "methods": {
      "type": "object",
      "required": ["web", "desktop_browser_qa", "browser_extension", "native_electron"],
      "properties": {
        "web": { "$ref": "#/$defs/method" },
        "desktop_browser_qa": { "$ref": "#/$defs/method" },
        "browser_extension": { "$ref": "#/$defs/method" },
        "native_electron": { "const": "manual_at" }
      },
      "additionalProperties": false
    },
    "criterion": {
      "type": "object",
      "required": ["criterion_id", "level", "title", "methods"],
      "properties": {
        "criterion_id": { "type": "string", "minLength": 3 },
        "level": { "enum": ["A", "AA"] },
        "title": { "type": "string", "minLength": 1 },
        "methods": { "$ref": "#/$defs/methods" }
      },
      "additionalProperties": false
    },
    "assessment": {
      "type": "object",
      "required": [
        "criterion_id",
        "surface",
        "method",
        "status",
        "evidence",
        "blocker_reason",
        "judgment"
      ],
      "properties": {
        "criterion_id": { "type": "string", "minLength": 3 },
        "surface": { "$ref": "#/$defs/surface" },
        "method": { "$ref": "#/$defs/method" },
        "status": { "$ref": "#/$defs/status" },
        "evidence": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "blocker_reason": { "type": ["string", "null"] },
        "judgment": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/judgment" }
          ]
        }
      },
      "additionalProperties": false
    },
    "judgment": {
      "type": "object",
      "required": [
        "agent_id",
        "tool_name",
        "input_ref",
        "output",
        "rationale",
        "latency_ms",
        "revision"
      ],
      "properties": {
        "agent_id": { "type": "string", "minLength": 1 },
        "tool_name": { "type": "string", "minLength": 1 },
        "input_ref": { "type": "string", "minLength": 1 },
        "output": { "enum": ["accepted", "rejected", "not_applicable"] },
        "rationale": { "type": "string", "minLength": 1 },
        "latency_ms": { "type": "integer", "minimum": 0 },
        "revision": { "type": "string", "pattern": "^[a-f0-9]{40}$" }
      },
      "additionalProperties": false
    },
    "routeCoverage": {
      "type": "object",
      "required": ["surface", "status", "route_results", "blocker_reason"],
      "properties": {
        "surface": { "$ref": "#/$defs/surface" },
        "status": { "$ref": "#/$defs/status" },
        "route_results": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["route_id", "states"],
            "properties": {
              "route_id": { "type": "string", "minLength": 1 },
              "states": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["state_id", "status", "evidence"],
                  "properties": {
                    "state_id": { "type": "string", "minLength": 1 },
                    "status": { "$ref": "#/$defs/status" },
                    "evidence": {
                      "type": "array",
                      "items": { "type": "string", "minLength": 1 }
                    }
                  },
                  "additionalProperties": false
                }
              }
            },
            "additionalProperties": false
          }
        },
        "blocker_reason": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    }
  }
}
