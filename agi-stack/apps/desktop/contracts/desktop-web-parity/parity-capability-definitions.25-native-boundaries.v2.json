        {
          "surface": "native_only",
          "actions": [
            "seal",
            "load",
            "replace",
            "clear",
            "migrate"
          ],
          "authentication": "native_shell",
          "authorization": [
            "vault:use"
          ],
          "enforcement": "enforced",
          "feature_gate": "application_encrypted_vault"
        }
      ],
      "interaction_states": [
        "vault-open",
        "seal",
        "load",
        "replace",
        "clear",
        "corrupt-or-unavailable"
      ],
      "expected_observable_result": "The sidecar stores trusted-session secret material and provider credentials in the application-managed encrypted vault, uses atomic replacement, fails closed on corrupt records, and never returns secret material to persistent renderer state or logs. Platform-private filesystem permission enforcement remains explicit and testable per OS.",
      "evidence_requirements": [
        "contract",
        "native_electron",
        "sidecar_authority",
        "desktop_bundle"
      ],
      "judgment_rationale": "The Rust vault, trusted-session broker, provider credential store, migration path, and control wiring form the native authority. The current implementation is degraded rather than fully available because Windows permission hardening is a no-op and the non-secret trusted-session reference remains SQLite metadata."
