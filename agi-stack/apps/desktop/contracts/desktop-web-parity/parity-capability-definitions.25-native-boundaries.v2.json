          "authentication": "native_shell",
          "authorization": [
            "trusted-renderer-origin"
          ],
          "enforcement": "enforced",
          "feature_gate": null
        },
        {
          "surface": "native_only",
          "actions": [
            "invoke-allowlisted-command"
          ],
          "authentication": "native_shell",
          "authorization": [
            "allowlisted-preload-bridge"
          ],
          "enforcement": "enforced",
          "feature_gate": null
