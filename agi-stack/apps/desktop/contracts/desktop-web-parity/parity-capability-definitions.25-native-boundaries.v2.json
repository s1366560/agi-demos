      ],
      "interaction_states": [
        "application-start",
        "renderer-bootstrap",
        "command-invocation",
        "navigation-attempt",
        "permission-request"
      ],
      "expected_observable_result": "The packaged Electron window runs with context isolation, renderer sandboxing, no Node integration, a minimal allowlisted preload bridge, trusted renderer protocol handling, and fail-closed navigation and permission policies.",
      "evidence_requirements": [
        "contract",
        "native_electron",
        "desktop_bundle",
        "release_pipeline"
      ],
      "judgment_rationale": "This is an implemented native-only security capability with no Web analogue. Parity requires preserving it while adding routes; renderer convenience must not weaken Electron isolation or expand IPC authority."
