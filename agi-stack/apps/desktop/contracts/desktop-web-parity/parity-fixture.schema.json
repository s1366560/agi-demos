{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MemStack Desktop and Web Shared Parity Fixture",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "case_id",
    "kind",
    "source_contract",
    "input",
    "web_expected_view_model",
    "desktop_expected_view_model"
  ],
  "properties": {
    "$schema": { "type": "string", "minLength": 1 },
    "schema_version": { "const": "1.0.0" },
    "case_id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "kind": {
      "enum": ["live_events", "history_replay", "capability_snapshot"]
    },
    "source_contract": { "type": "string", "minLength": 1 },
    "input": { "type": "object" },
    "web_expected_view_model": { "type": "object" },
    "desktop_expected_view_model": { "type": "object" }
  },
  "oneOf": [
    {
      "type": "object",
      "required": ["kind", "input"],
      "properties": {
        "kind": { "const": "live_events" },
        "input": {
          "type": "object",
          "additionalProperties": false,
          "required": ["transport", "events"],
          "properties": {
            "transport": { "const": "websocket" },
            "events": {
              "type": "array",
              "minItems": 2,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["type", "message_id", "data"],
                "properties": {
                  "type": { "type": "string", "minLength": 1 },
                  "message_id": { "type": "string", "minLength": 1 },
                  "data": { "type": "object" }
                }
              }
            }
          }
        }
      }
    },
    {
      "type": "object",
      "required": ["kind", "input"],
      "properties": {
        "kind": { "const": "history_replay" },
        "input": {
          "type": "object",
          "additionalProperties": false,
          "required": ["transport", "records"],
          "properties": {
            "transport": { "const": "sessions_history" },
            "records": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["event_type", "message_id", "payload"],
                "properties": {
                  "event_type": { "type": "string", "minLength": 1 },
                  "message_id": { "type": "string", "minLength": 1 },
                  "payload": { "type": "object" }
                }
              }
            }
          }
        }
      }
    },
    {
      "type": "object",
      "required": ["kind", "input"],
      "properties": {
        "kind": { "const": "capability_snapshot" },
        "input": {
          "type": "object",
          "additionalProperties": false,
          "required": ["snapshot"],
          "properties": {
            "snapshot": {
              "type": "object",
              "additionalProperties": false,
              "required": ["version", "mode", "capabilities"],
              "properties": {
                "version": { "const": "1.0.0" },
                "mode": { "enum": ["cloud", "local", "native"] },
                "capabilities": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "automation_run",
                    "search",
                    "workspace_collaboration",
                    "sandbox_isolation"
                  ],
                  "properties": {
                    "automation_run": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["available", "reason_code"],
                      "properties": {
                        "available": { "type": "boolean" },
                        "reason_code": { "type": ["string", "null"] }
                      }
                    },
                    "search": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["available", "reason_code"],
                      "properties": {
                        "available": { "type": "boolean" },
                        "reason_code": { "type": ["string", "null"] }
                      }
                    },
                    "workspace_collaboration": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["available", "reason_code"],
                      "properties": {
                        "available": { "type": "boolean" },
                        "reason_code": { "type": ["string", "null"] }
                      }
                    },
                    "sandbox_isolation": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["available", "reason_code"],
                      "properties": {
                        "available": { "type": "boolean" },
                        "reason_code": { "type": ["string", "null"] }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  ]
}
