            { "surfaces": ["desktop_local"], "method": "GET", "path": "/api/v1/tenants" },
            { "surfaces": ["web", "desktop_cloud"], "method": "GET", "path": "/api/v1/projects/" },
            { "surfaces": ["desktop_local"], "method": "GET", "path": "/api/v1/projects" },
            { "surfaces": ["web", "desktop_cloud", "desktop_local"], "method": "GET", "path": "/api/v1/agent/conversations" }
          ],
          "data_states": ["loading", "empty", "ready", "stale", "forbidden", "unavailable", "retry"],
          "interaction_states": ["bootstrap", "deep-link-restore", "scope-switch", "refresh", "retry"],
          "evidence_requirements": ["contract", "web_renderer", "desktop_renderer", "native_electron", "sidecar_authority"],
          "expected_observable_result": "Each surface restores an authenticated session and resolves the same tenant, project, workspace and conversation scope without exposing a browser token or crossing an undeclared authority boundary."
        },
