          "id": "bootstrap-and-scope",
          "title": "Login bootstrap, tenant, project and workspace scope restoration",
          "mode_policy": {
            "web": "required",
            "desktop_cloud": "required",
            "desktop_local": "required",
            "native_only": "not_applicable"
          },
          "actions": {
            "web": ["restore-session", "load-system-features", "load-tenants", "select-tenant", "select-project", "resolve-conversation"],
            "desktop_cloud": ["restore-session", "load-system-features", "load-tenants", "select-tenant", "select-project", "resolve-conversation"],
            "desktop_local": ["restore-session", "load-tenants", "select-tenant", "select-project", "resolve-conversation"],
            "native_only": []
          },
          "contracts": [
            { "surfaces": ["web", "desktop_cloud", "desktop_local"], "method": "GET", "path": "/api/v1/auth/me" },
            { "surfaces": ["web", "desktop_cloud", "desktop_local"], "method": "GET", "path": "/api/v1/workspace-context" },
            { "surfaces": ["web", "desktop_cloud"], "method": "GET", "path": "/api/v1/system/features" },
