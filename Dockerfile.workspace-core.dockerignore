# Restrict this Dockerfile's context without changing other image builds.
**
!Dockerfile.workspace-core
!third_party/
third_party/*
!third_party/avernet-bcs/
third_party/avernet-bcs/*
!third_party/avernet-bcs/Cargo.toml
!third_party/avernet-bcs/Cargo.lock
!third_party/avernet-bcs/crates/
!third_party/avernet-bcs/crates/**
!docker/
docker/*
!docker/workspace-core/
docker/workspace-core/*
!docker/workspace-core/entrypoint.sh
!docker/workspace-core/bcs-config.toml.template

# Preserve the global context's exclusion of generated and private files.
**/target
**/node_modules
**/.git
**/.env
**/.env.*
**/.ssh
**/.aws
**/.netrc
**/.npmrc
**/.pypirc
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/secrets
**/*.secret.yaml
**/*.tfvars
**/__pycache__
**/*.pyc
**/.venv
**/.cache
**/*.log
**/*.pid
**/*.db
**/*.sqlite
**/*.sqlite3
**/.DS_Store
