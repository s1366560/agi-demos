{
    "compilerOptions": {
        "target": "ES2022",
        "useDefineForClassFields": true,
        "lib": [
            "ES2022",
            "DOM",
            "DOM.Iterable"
        ],
        "module": "ESNext",
        "skipLibCheck": true,
        /* Bundler mode */
        "moduleResolution": "bundler",
        "allowImportingTsExtensions": true,
        "resolveJsonModule": true,
        "isolatedModules": true,
        "noEmit": true,
        "jsx": "react-jsx",
        /* Linting - TDD Phase 1.4: Enhanced Strict Mode */
        "strict": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "noFallthroughCasesInSwitch": true,
        "noImplicitReturns": true,
        "noImplicitOverride": true,
        "forceConsistentCasingInFileNames": true,
        "noUncheckedIndexedAccess": true,
        "exactOptionalPropertyTypes": true,
        /* Path mapping */
        "baseUrl": ".",
        "paths": {
            "cytoscape": ["node_modules/cytoscape"],
            "three": ["node_modules/@types/three"],
            "three-mesh-bvh": ["node_modules/three-mesh-bvh"],
            "@react-three/*": ["node_modules/@react-three/*"],
            "docx-preview": ["node_modules/docx-preview"],
            "xlsx": ["node_modules/xlsx"],
            "@copilotkit/a2ui-renderer": ["node_modules/@copilotkit/a2ui-renderer/dist/index.d.cts"],
            "@copilotkit/a2ui-renderer/dist/*": ["node_modules/@copilotkit/a2ui-renderer/dist/*"],
            "react-router-dom": ["node_modules/react-router-dom"],
            "@tanstack/react-query": ["node_modules/@tanstack/react-query"],
            "@tanstack/react-virtual": ["node_modules/@tanstack/react-virtual"],
            "chart.js": ["node_modules/chart.js"],
            "react-chartjs-2": ["node_modules/react-chartjs-2"],
            "remark-gfm": ["node_modules/remark-gfm"],
            "remark-math": ["node_modules/remark-math"],
            "rehype-katex": ["node_modules/rehype-katex"],
            "react-markdown": ["node_modules/react-markdown"],
            "i18next": ["node_modules/i18next"],
            "use-debounce": ["node_modules/use-debounce"],
            "uuid": ["node_modules/uuid"],
            "zustand": ["node_modules/zustand"],
            "zustand/*": ["node_modules/zustand/*"],
            "antd/*": ["node_modules/antd/*"],
            "@xterm/*": ["./node_modules/@xterm/*"],
            "@business/*": ["../plugins/business/*"],
            "react": ["node_modules/@types/react"],
            "react/*": ["node_modules/@types/react/*"],
            "react-i18next": ["node_modules/react-i18next"],
            "antd": ["node_modules/antd"],
            "lucide-react": ["node_modules/lucide-react"],
            "@/*": [
                "src/*"
            ],
            "@agistack/plugin-slots": [
                "../agi-stack/packages/plugin-slots/src/index.ts"
            ],
            "@agistack/plugin-runtime": [
                "../agi-stack/packages/plugin-runtime/src/index.ts"
            ]
        }
    },
    "include": [
        "src"
    ],
    "exclude": [
        "src/test/**/*",
        "src/**/*.test.ts",
        "src/**/*.test.tsx",
        "**/*.spec.ts",
        "**/*.spec.tsx"
    ],
    "references": [
        {
            "path": "./tsconfig.node.json"
        }
    ]
}
