# syntax=docker/dockerfile:1.7

ARG PYTHON_VERSION=3.12.13

FROM python:${PYTHON_VERSION}-slim

ARG RAY_VERSION=2.53.0
ARG UV_VERSION=0.12.13

USER root
WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app \
    UV_PROJECT_ENVIRONMENT=/opt/memstack-venv \
    UV_LINK_MODE=copy \
    PATH="/opt/memstack-venv/bin:${PATH}"

RUN apt-get update \
    && apt-get install -y --no-install-recommends bash ca-certificates curl git \
    && rm -rf /var/lib/apt/lists/*

# Source changes reuse the locked dependency layer. A changed declaration or lock
# is rebuilt by Compose --build; --locked refuses an inconsistent pair.
RUN python -m pip install --no-cache-dir "uv==${UV_VERSION}"
COPY pyproject.toml uv.lock ./
RUN --mount=type=cache,target=/root/.cache/uv,sharing=locked \
    uv sync --locked --no-dev --no-install-project --extra ray-runtime \
    && test "$(python -c 'from importlib.metadata import version; print(version("ray"))')" = "${RAY_VERSION}"
COPY pyproject.toml uv.lock /opt/memstack-ray-dependencies/

# The worker imports the Python runtime and performs the same bundle verification
# as the API. Package only the cross-target sources referenced by that bundle.
COPY src ./src
COPY config ./config
COPY shared ./shared
COPY contracts ./contracts
COPY alembic ./alembic
COPY alembic.ini ./
COPY memstack_tools ./memstack_tools
COPY sdk/memstack-plugin-sdk/src ./sdk/memstack-plugin-sdk/src
COPY plugins/business ./plugins/business
COPY plugins/adapters ./plugins/adapters
RUN --mount=type=bind,target=/context \
    python /context/docker/ray/copy-module-artifacts.py /context /app
COPY docker/ray/start-runtime.py /usr/local/libexec/memstack-ray/start-runtime.py
COPY docker/ray/check-actor-ready.py /usr/local/libexec/memstack-ray/check-actor-ready.py

ENTRYPOINT ["python", "/usr/local/libexec/memstack-ray/start-runtime.py", "--"]
