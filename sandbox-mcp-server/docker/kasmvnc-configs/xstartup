#!/usr/bin/env bash

set -Eeuo pipefail

export HOME=/home/sandbox
export DISPLAY="${DISPLAY:-:1}"
export XAUTHORITY="${XAUTHORITY:-${HOME}/.Xauthority}"
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/10001}"
export XDG_SESSION_TYPE=x11
export XDG_CURRENT_DESKTOP=Openbox
export DESKTOP_SESSION=openbox
export DBUS_SESSION_BUS_ADDRESS="${DBUS_SESSION_BUS_ADDRESS:-unix:path=/run/user/10001/bus}"
export XDG_CONFIG_HOME="${HOME}/.config"
export XDG_CACHE_HOME="${HOME}/.cache"
export XDG_DATA_HOME="${HOME}/.local/share"
export XDG_STATE_HOME="${HOME}/.local/state"

mkdir -p \
    "${XDG_CONFIG_HOME}/openbox" \
    "${XDG_CACHE_HOME}" \
    "${XDG_DATA_HOME}" \
    "${XDG_STATE_HOME}" \
    "${HOME}/Desktop" \
    "${HOME}/Downloads"

cp /etc/xdg/openbox/rc.xml "${XDG_CONFIG_HOME}/openbox/rc.xml"
cp /etc/xdg/openbox/menu.xml "${XDG_CONFIG_HOME}/openbox/menu.xml"

xset s off 2>/dev/null || true
xset -dpms 2>/dev/null || true
xset s noblank 2>/dev/null || true
xsetroot -solid '#20242b' -cursor_name left_ptr 2>/dev/null || true

exec openbox --config-file "${XDG_CONFIG_HOME}/openbox/rc.xml"
